# PLC Configuration — fill in after site visit
PLC_ENABLED=false
PLC_IP=192.168.x.x
PLC_PORT=502
POLL_INTERVAL=5

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=opmas_db
DB_USER=opmas_user
DB_PASSWORD=changeme

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/collector.log
